# =========================================================
# Makao — .gitignore
# =========================================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ---------- Virtual environments ----------
venv/
env/
ENV/
.venv/
.env/
virtualenv/
*.venv

# ---------- Django ----------
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
/media/
/staticfiles/

# ---------- Environment & secrets ----------
.env
.env.*
!.env.example

# ---------- Cloudinary ----------
# (no local cache to ignore — uploads live on Cloudinary)

# ---------- OS ----------
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ---------- Editors & IDEs ----------
.vscode/
.idea/
*.swp
*.swo
*.swn
*~
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# ---------- Testing / coverage ----------
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.tox/
.cache/
nosetests.xml
coverage.xml
*.cover
.hypothesis/

# ---------- MyPy / type checkers ----------
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/

# ---------- Deployment artifacts ----------
/staticfiles/
*.pid
*.seed
*.pid.lock

# ---------- Node (if you ever add tooling) ----------
node_modules/
npm-debug.log
yarn-error.log

# ---------- Local scratch ----------
scratch/
notes/
*.bak
*.tmp